# Local software demo. Copy to .env in the repository root.
USE_MOCK=true
LOCKER_CONTROL_MODE=mock
LOCKER_MOCK_AUTO_COMPLETE=true
PLATFORM_PUSH_MODE=mock
FLASK_HOST=127.0.0.1
PORT=5000
# If empty, a random session secret is generated at each launch.
FLASK_SECRET_KEY=
WX_APP_ID=
WX_APP_SECRET=
# Real vision remains optional. The walkthrough stubs it explicitly.
AI_DETECTION_MODE=local
AI_PYTHON_BIN=python
# For real inference, set these to absolute paths in your own environment:
# AI_YOLO_ROOT=
# AI_LOCAL_WEIGHTS=
# DATABASE_URL=sqlite:///...
