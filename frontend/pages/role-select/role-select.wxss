.page {
  min-height: 100vh;
  padding: 48px 16px 28px;
  box-sizing: border-box;
  background: #f4f7fb;
}

.hero,
.role-card {
  margin-bottom: 14px;
  padding: 18px;
  border: 1px solid #e4ebf5;
  border-radius: 22px;
  background: #ffffff;
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
}

.eyebrow {
  display: block;
  margin-bottom: 6px;
  font-size: 11px;
  font-weight: 800;
  color: #2563eb;
}

.title {
  display: block;
  font-size: 24px;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.sub,
.role-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: #64748b;
}

.role-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.user-card {
  border-color: #bfdbfe;
}

.courier-card {
  border-color: #99f6e4;
}

.role-title {
  display: block;
  font-size: 18px;
  font-weight: 900;
  color: #111827;
}

.role-action {
  flex-shrink: 0;
  min-height: 34px;
  padding: 0 14px;
  border-radius: 999px;
  color: #ffffff;
  background: #2563eb;
  font-size: 13px;
  line-height: 34px;
  font-weight: 900;
}

.courier-card .role-action {
  background: #0f766e;
}

.switch-btn {
  margin-top: 4px;
  height: 48px;
  line-height: 48px;
  border-radius: 16px;
  color: #334155;
  background: #ffffff;
  border: 1px solid #dbe7f5;
  font-size: 14px;
  font-weight: 800;
}
