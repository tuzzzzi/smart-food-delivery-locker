<view class="page">
  <view class="hero">
    <view class="hero-main">
      <text class="eyebrow">{{role==='courier' ? '投递异常' : '取件问题'}}</text>
      <text class="title">{{pageTitle}}</text>
      <text class="desc">{{pageDesc}}</text>
    </view>
    <text class="role-chip">{{role==='courier' ? '配送员' : '用户'}}</text>
  </view>

  <view class="status-card">
    <view>
      <text class="section-kicker">当前问题</text>
      <text class="status-title">{{sceneLabel}}</text>
    </view>
    <text class="status-badge badge-{{sceneClass}}">{{sceneLabel}}</text>
    <text class="status-message" wx:if="{{message}}">{{message}}</text>
  </view>

  <view class="context-card" wx:if="{{role==='courier' && task}}">
    <view class="card-head">
      <text class="section-title">当前任务</text>
      <text class="status-badge badge-info">{{task.statusText}}</text>
    </view>
    <view class="info-row">
      <text>柜号</text>
      <text>{{task.boxNo || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{task.merchantName}}">
      <text>商家</text>
      <text>{{task.merchantName}}</text>
    </view>
    <view class="info-row" wx:if="{{task.receiverPhoneText}}">
      <text>收件人</text>
      <text>{{task.receiverPhoneText}}</text>
    </view>
    <view class="note" wx:if="{{task.exceptionStatusText || task.aiMessage || task.exceptionNote}}">
      {{task.exceptionStatusText || task.aiMessage || task.exceptionNote}}
    </view>
  </view>

  <view class="context-card" wx:if="{{role==='user' && pkg}}">
    <view class="card-head">
      <text class="section-title">包裹信息</text>
      <text class="status-badge badge-info">{{pkg.statusText}}</text>
    </view>
    <view class="info-row">
      <text>柜号</text>
      <text>{{pkg.boxNo || '-'}}</text>
    </view>
    <view class="info-row" wx:if="{{pkg.merchantName}}">
      <text>商家</text>
      <text>{{pkg.merchantName}}</text>
    </view>
    <view class="info-row">
      <text>状态</text>
      <text>{{pkg.statusText}}</text>
    </view>
  </view>

  <view class="tips-card" wx:if="{{tips.length}}">
    <text class="section-title">可能原因与建议</text>
    <block wx:for="{{tips}}" wx:key="index">
      <view class="tip-item">
        <text class="tip-index">{{index + 1}}</text>
        <text class="tip-text">{{item}}</text>
      </view>
    </block>
  </view>

  <view class="action-card" wx:if="{{role==='courier'}}">
    <text class="section-title">处理操作</text>
    <button
      class="btn primary"
      bindtap="retryTaskNow"
      loading="{{actionLoading==='retry'}}"
      disabled="{{!!actionLoading}}"
    >
      {{task && task.exceptionResolved ? '返回任务' : '重新投递'}}
    </button>
    <button
      class="btn danger"
      bindtap="cancelCurrentTask"
      loading="{{actionLoading==='cancel'}}"
      disabled="{{!!actionLoading}}"
      wx:if="{{!task || !task.exceptionResolved}}"
    >
      提交管理员处理
    </button>
    <button class="btn ghost" bindtap="goCourierHome" disabled="{{!!actionLoading}}">返回任务列表</button>
  </view>

  <view class="action-card" wx:if="{{role==='user'}}">
    <text class="section-title">处理操作</text>
    <button
      class="btn primary"
      bindtap="retryOpenDoor"
      loading="{{actionLoading==='openDoor'}}"
      disabled="{{!!actionLoading}}"
      wx:if="{{pkg && pkg.status==='pending'}}"
    >
      返回取件
    </button>
    <button
      class="btn secondary"
      bindtap="refreshPackageStatus"
      loading="{{actionLoading==='refresh'}}"
      disabled="{{!!actionLoading}}"
    >
      刷新状态
    </button>
    <button class="btn ghost" bindtap="goRemindList" disabled="{{!!actionLoading}}">查看管理员提醒</button>
    <button class="btn ghost" bindtap="goUserHome" disabled="{{!!actionLoading}}">返回首页</button>
  </view>

  <view class="hint" wx:if="{{hintText}}">
    <text>{{hintText}}</text>
  </view>
</view>
