.page {
  min-height: 100vh;
  padding: 20px 16px 28px;
  box-sizing: border-box;
  background: #f4f7fb;
}

.hero,
.role-panel,
.form-card {
  margin-bottom: 14px;
  padding: 18px;
  border: 1px solid #e4ebf5;
  border-radius: 22px;
  background: #ffffff;
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
}

.panel-title {
  display: block;
  margin-bottom: 12px;
  font-size: 16px;
  font-weight: 900;
  color: #111827;
}

.role-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.role-option {
  min-height: 92px;
  padding: 14px;
  border: 1px solid #dbe7f5;
  border-radius: 16px;
  background: #f8fafc;
  box-sizing: border-box;
}

.role-option.active {
  border-color: #2563eb;
  background: #eff6ff;
  box-shadow: inset 0 0 0 1px #2563eb;
}

.role-title,
.role-desc {
  display: block;
}

.role-title {
  font-size: 15px;
  font-weight: 900;
  color: #111827;
}

.role-desc {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.5;
  color: #64748b;
}

.eyebrow {
  display: block;
  margin-bottom: 6px;
  font-size: 11px;
  font-weight: 800;
  color: #2563eb;
}

.title {
  display: block;
  font-size: 24px;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.sub,
.phone-text,
.hint {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: #64748b;
}

.form-item {
  margin-bottom: 16px;
}

.label {
  display: block;
  margin-bottom: 8px;
  font-size: 13px;
  font-weight: 800;
  color: #334155;
}

.input {
  height: 52px;
  padding: 0 14px;
  border: 1px solid #dbe7f5;
  border-radius: 16px;
  background: #f8fafc;
  font-size: 15px;
  box-sizing: border-box;
}

.code-row {
  display: flex;
  align-items: flex-end;
  gap: 10px;
}

.code-left {
  flex: 1;
  min-width: 0;
}

.btn {
  margin-top: 12px;
  height: 50px;
  line-height: 50px;
  border-radius: 16px;
  font-size: 15px;
  font-weight: 900;
}

.send-code-btn {
  width: 128px;
  flex: none;
}

.primary {
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
}

.secondary {
  color: #0f766e;
  background: #ecfdf5;
  border: 1px solid #99f6e4;
}

.hint {
  text-align: center;
  color: #b91c1c;
}

@media (max-width: 360px) {
  .role-grid {
    grid-template-columns: 1fr;
  }
}
