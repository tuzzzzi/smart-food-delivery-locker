<view class="page">
  <view class="hero">
    <text class="eyebrow">首次使用</text>
    <text class="title">选择身份并完善资料</text>
    <text class="sub">系统会根据注册身份进入对应流程；配送员需等待管理员审核通过后才能使用工作台。</text>
  </view>

  <view class="role-panel">
    <text class="panel-title">注册身份</text>
    <view class="role-grid">
      <view
        class="role-option {{selectedRole==='user' ? 'active' : ''}}"
        data-role="user"
        bindtap="selectRole"
      >
        <text class="role-title">取件用户</text>
        <text class="role-desc">用于查看包裹、取件码和取件提醒</text>
      </view>
      <view
        class="role-option {{selectedRole==='courier' ? 'active' : ''}}"
        data-role="courier"
        bindtap="selectRole"
      >
        <text class="role-title">配送员</text>
        <text class="role-desc">提交资料后进入管理员审核</text>
      </view>
    </view>
  </view>

  <view class="form-card">
    <block wx:if="{{selectedRole==='user'}}">
      <view class="form-item">
        <text class="label">昵称 *</text>
        <input class="input" placeholder="请输入昵称" bindinput="onNickInput" value="{{nickname}}" />
      </view>

      <view class="form-item">
        <text class="label">收件人姓名 *</text>
        <input class="input" placeholder="请输入收件人姓名" bindinput="onReceiverNameInput" value="{{receiverName}}" />
      </view>
    </block>

    <block wx:if="{{selectedRole==='courier'}}">
      <view class="form-item">
        <text class="label">配送员姓名 *</text>
        <input class="input" placeholder="请输入配送员姓名" bindinput="onCourierNameInput" value="{{courierName}}" />
      </view>
    </block>

    <view class="form-item">
      <text class="label">手机号 *</text>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        bindinput="onPhoneInput"
        value="{{phoneNumber}}"
      />
      <button class="btn secondary"
              open-type="getPhoneNumber"
              bindgetphonenumber="onGetPhoneNumber"
              loading="{{gettingPhone}}"
              disabled="{{gettingPhone}}">
        微信授权手机号
      </button>
      <text class="phone-text" wx:if="{{phoneNumber}}">已填写：{{phoneNumber}}</text>
    </view>

    <view class="form-item code-row">
      <view class="code-left">
        <text class="label">验证码 *</text>
        <input
          class="input"
          type="number"
          maxlength="6"
          placeholder="请输入 6 位验证码"
          bindinput="onCodeInput"
          value="{{code}}"
        />
      </view>
      <button
        class="btn secondary send-code-btn"
        bindtap="sendCode"
        loading="{{sending}}"
        disabled="{{sending || countdown>0}}"
      >
        <block wx:if="{{countdown>0}}">{{countdown}}s后重发</block>
        <block wx:else>发送验证码</block>
      </button>
    </view>

    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" placeholder="可选，便于接收通知" bindinput="onEmailInput" value="{{email}}" />
    </view>

    <block wx:if="{{selectedRole==='user'}}">
      <view class="form-item">
        <text class="label">常用取件区域</text>
        <input class="input" placeholder="例如：东区宿舍、食堂旁、一号柜区域" bindinput="onPickupAreaInput" value="{{pickupArea}}" />
      </view>

      <view class="form-item">
        <text class="label">备用联系电话</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="可选，备用联系方式"
          bindinput="onBackupPhoneInput"
          value="{{backupPhone}}"
        />
      </view>
    </block>

    <button class="btn primary" bindtap="submit" loading="{{loading}}" disabled="{{loading}}">
      <block wx:if="{{selectedRole==='courier'}}">保存并进入审核状态</block>
      <block wx:else>保存并进入用户首页</block>
    </button>

    <view class="hint" wx:if="{{hintText}}">
      <text>{{hintText}}</text>
    </view>
  </view>
</view>
