<view class="page">
  <view class="hero">
    <view>
      <text class="eyebrow">消息中心</text>
      <text class="title">取件提醒</text>
      <text class="sub">取件、超时和问题提醒会集中展示，未读消息会优先标记。</text>
    </view>
    <button class="mark-btn" bindtap="markAllRead">全部已读</button>
  </view>

  <view class="summary-row">
    <view class="summary-card highlight">
      <text class="summary-num">{{unreadCount}}</text>
      <text class="summary-label">未读提醒</text>
    </view>
    <view class="summary-card">
      <text class="summary-num">{{totalCount}}</text>
      <text class="summary-label">全部提醒</text>
    </view>
  </view>

  <view wx:if="{{items.length===0}}" class="empty">
    <text class="empty-title">暂无提醒</text>
    <text class="empty-desc">有新的取件、超时或问题提醒时会显示在这里。</text>
  </view>

  <view class="list">
    <view
      class="item {{item.readAt ? 'read' : 'unread'}}"
      wx:for="{{items}}"
      wx:key="id"
      bindtap="markOneRead"
      data-id="{{item.id}}"
    >
      <view class="item-head">
        <text class="type-chip {{item.typeClass}}">{{item.typeText}}</text>
        <text class="read-chip">{{item.statusText}}</text>
      </view>

      <text class="msg">{{item.message}}</text>

      <view class="package-line">
        <text>{{item.merchantName || '校园外卖包裹'}}</text>
        <text wx:if="{{item.boxNo}}">柜号 {{item.boxNo}}</text>
        <text wx:else>柜号同步中</text>
      </view>

      <view class="meta-row">
        <text>{{item.timeText}}</text>
        <text>{{item.sourceText}}</text>
      </view>

      <view class="action-row" wx:if="{{item.packageId}}">
        <button class="action-btn primary-action" catchtap="goGuide" data-id="{{item.id}}" data-pid="{{item.packageId}}">
          去取件
        </button>
        <button class="action-btn ghost-action" catchtap="goPackageDetail" data-id="{{item.id}}" data-pid="{{item.packageId}}">
          查看入柜照片
        </button>
      </view>
    </view>
  </view>

  <view class="hint" wx:if="{{hintText}}">
    <text>{{hintText}}</text>
  </view>
</view>
