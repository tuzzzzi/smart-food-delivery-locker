<view class="page">
  <view class="hero">
    <text class="eyebrow">配送员资料</text>
    <text class="title">我的配送资料</text>
    <text class="sub">完善联系信息和服务范围，便于管理员分配投递任务。</text>
  </view>

  <view class="form-card">
    <text class="card-title">基础信息</text>

    <view class="avatar-row">
      <view class="avatar-preview">
        <image class="avatar-img" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <text class="avatar-placeholder" wx:else>头像</text>
      </view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
    </view>

    <view class="form-item">
      <text class="label">配送员姓名</text>
      <input class="input" placeholder="请输入配送员姓名" value="{{profile.courierName}}" bindinput="onNameInput" />
    </view>

    <view class="form-item">
      <text class="label">配送员昵称</text>
      <input class="input" placeholder="可选，默认使用配送员姓名" value="{{profile.nickname}}" bindinput="onNicknameInput" />
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{profile.phoneNumber}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" placeholder="可选，便于接收通知" value="{{profile.email}}" bindinput="onEmailInput" />
    </view>

    <button class="btn primary" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">
      保存资料
    </button>
  </view>

  <view class="status-card">
    <text class="card-title">身份状态</text>
    <view class="status-list">
      <view class="status-row">
        <text class="status-label">服务范围</text>
        <text class="status-value scope-value">{{profile.serviceArea}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">认证状态</text>
        <text class="status-value">{{profile.applyStatusText}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">工作状态</text>
        <text class="status-value">{{profile.workStatus}}</text>
      </view>
    </view>
  </view>

  <view class="hint" wx:if="{{hintText}}">
    <text>{{hintText}}</text>
  </view>
</view>
