<view class="page">
  <view class="hero">
    <text class="eyebrow">账号资料</text>
    <text class="title">个人资料</text>
    <text class="sub">完善手机号后，系统会根据收件信息自动匹配你的待取外卖。</text>
  </view>

  <view class="status-card">
    <text class="card-title">账号状态</text>
    <view class="status-list">
      <view class="status-row">
        <text class="status-label">当前身份</text>
        <text class="status-value">{{accountView.identityText}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">手机号状态</text>
        <text class="status-value">{{accountView.phoneStatusText}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">取件匹配</text>
        <text class="status-value">{{accountView.pickupMatchText}}</text>
      </view>
    </view>
  </view>

  <view class="form-card">
    <text class="card-title">基础资料</text>

    <view class="avatar-row">
      <view class="avatar-preview">
        <image class="avatar-img" wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <text class="avatar-placeholder" wx:else>头像</text>
      </view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">选择头像</button>
    </view>

    <view class="form-item">
      <text class="label">昵称</text>
      <input class="input" placeholder="请输入昵称" value="{{form.username}}" data-field="username" bindinput="onFormInput" bindblur="onFormInput" />
    </view>

    <view class="form-item">
      <text class="label">收件人姓名</text>
      <input class="input" placeholder="请输入收件人姓名" value="{{form.receiverName}}" data-field="receiverName" bindinput="onFormInput" bindblur="onFormInput" />
      <text class="hint-inline">用于展示真实收件信息。</text>
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{form.phoneNumber}}" data-field="phoneNumber" bindinput="onFormInput" bindblur="onFormInput" />
      <text class="hint-inline">用于匹配你的待取包裹。</text>
    </view>

    <view class="form-item">
      <text class="label">邮箱</text>
      <input class="input" placeholder="可选，便于接收通知" value="{{form.email}}" data-field="email" bindinput="onFormInput" bindblur="onFormInput" />
    </view>

    <view class="form-item">
      <text class="label">常用取件区域</text>
      <input class="input" placeholder="例如：东区宿舍、食堂旁、一号柜区域" value="{{form.pickupArea}}" data-field="pickupArea" bindinput="onFormInput" bindblur="onFormInput" />
    </view>

    <view class="form-item">
      <text class="label">备用联系电话</text>
      <input class="input" type="number" maxlength="11" placeholder="可选，备用联系方式" value="{{form.backupPhone}}" data-field="backupPhone" bindinput="onFormInput" bindblur="onFormInput" />
    </view>

    <view class="form-item">
      <text class="label">备注信息</text>
      <textarea class="textarea" placeholder="可填写取件偏好或其他备注" value="{{profile.note}}" bindinput="onNoteInput" bindblur="onNoteInput"></textarea>
    </view>

    <button class="btn primary" bindtap="saveProfile" loading="{{saving}}" disabled="{{saving}}">
      保存资料
    </button>
  </view>

  <view class="service-section" wx:if="{{accountView.serviceMode !== 'none'}}">
    <text class="card-title">更多服务</text>
    <view class="service-card" bindtap="goMoreService">
      <view class="service-main">
        <text class="service-title">{{accountView.serviceTitle}}</text>
        <text class="service-desc">{{accountView.serviceDesc}}</text>
      </view>
      <text class="service-action">{{accountView.serviceAction}}</text>
    </view>
  </view>

  <view class="bottom-card">
    <button class="btn ghost switch-btn" bindtap="switchIdentity">切换账号</button>
  </view>

  <view class="hint" wx:if="{{hintText}}">
    <text>{{hintText}}</text>
  </view>
</view>
