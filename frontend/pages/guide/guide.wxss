.page {
  min-height: 100vh;
  padding: 20px 16px 32px;
  box-sizing: border-box;
  background: #f4f7fb;
}

.hero,
.steps-card,
.info-card,
.status-card,
.ai-card,
.evidence-card,
.cabinet-card,
.operation-card {
  margin-bottom: 14px;
  padding: 18px;
  border: 1px solid #e4ebf5;
  border-radius: 22px;
  background: #ffffff;
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  background: linear-gradient(135deg, #ffffff 0%, #eef6ff 100%);
}

.eyebrow,
.section-kicker {
  display: block;
  margin-bottom: 6px;
  font-size: 11px;
  font-weight: 800;
  color: #2563eb;
}

.title {
  display: block;
  font-size: 24px;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.sub,
.status-text,
.section-desc,
.hint {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: #64748b;
}

.role-chip,
.status-chip {
  flex-shrink: 0;
  min-height: 28px;
  padding: 0 12px;
  border-radius: 999px;
  font-size: 12px;
  line-height: 28px;
  font-weight: 800;
}

.role-courier,
.chip-blue,
.status-neutral,
.status-processing,
.status-waiting {
  color: #1d4ed8;
  background: #eff6ff;
}

.role-user,
.chip-success,
.status-ok,
.ai-pass {
  color: #059669;
  background: #ecfdf5;
}

.chip-warn,
.status-danger,
.ai-fail {
  color: #c2410c;
  background: #fff7ed;
}

.ai-waiting {
  color: #1d4ed8;
  background: #eff6ff;
}

.steps-card {
  padding: 10px 14px;
}

.user-main-card {
  margin-bottom: 12px;
}

.user-main-card .locker-block {
  margin-top: 14px;
}

.pickup-actions {
  margin-top: 4px;
  align-items: stretch;
}

.inline-error-btn {
  margin-top: 8px;
  color: #64748b;
}

.user-steps-card {
  padding: 14px 12px 12px;
}

.compact-title {
  margin: 0 4px 10px;
  font-size: 15px;
  font-weight: 900;
  color: #111827;
}

.user-step-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4px;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #edf2f7;
}

.step-item:last-child {
  border-bottom: 0;
}

.step-dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 13px;
  line-height: 28px;
  font-weight: 900;
  text-align: center;
  flex-shrink: 0;
}

.step-current .step-dot {
  color: #ffffff;
  background: #2563eb;
}

.step-done .step-dot {
  color: #ffffff;
  background: #10b981;
}

.step-alert .step-dot {
  color: #ffffff;
  background: #f97316;
}

.step-title {
  display: block;
  font-size: 14px;
  font-weight: 900;
  color: #111827;
}

.step-desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.6;
  color: #64748b;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.section-title {
  display: block;
  font-size: 17px;
  line-height: 1.35;
  font-weight: 900;
  color: #111827;
}

.locker-block {
  margin-top: 16px;
  padding: 18px;
  border-radius: 20px;
  background: #0f172a;
  color: #ffffff;
}

.locker-label {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.72);
}

.locker-no {
  display: block;
  margin-top: 4px;
  font-size: 42px;
  line-height: 1.1;
  font-weight: 900;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-top: 14px;
}

.info-item {
  min-height: 64px;
  padding: 12px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #edf2f7;
  box-sizing: border-box;
}

.info-label {
  display: block;
  font-size: 11px;
  color: #64748b;
}

.info-value {
  display: block;
  margin-top: 6px;
  font-size: 14px;
  font-weight: 800;
  color: #111827;
}

.pickup-code-item {
  background: #f8fbff;
  border-color: #dbeafe;
}

.pickup-code-value {
  color: #2563eb;
  font-size: 16px;
}

.next-card,
.notice-card {
  margin-top: 14px;
  padding: 14px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #edf2f7;
}

.next-title,
.notice-title {
  display: block;
  font-size: 14px;
  font-weight: 900;
  color: #111827;
}

.next-desc,
.notice-desc {
  display: block;
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.7;
  color: #64748b;
}

.success-notice {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.proof-image {
  width: 100%;
  height: 180px;
  margin-top: 16px;
  border-radius: 18px;
  background: #f8fafc;
}

.image-placeholder {
  margin-top: 16px;
  padding: 28px 16px;
  border: 1px dashed #cbd5e1;
  border-radius: 18px;
  background: #f8fafc;
  text-align: center;
}

.placeholder-title {
  display: block;
  font-size: 15px;
  font-weight: 900;
  color: #334155;
}

.placeholder-text {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.7;
  color: #64748b;
}

.cabinet {
  margin-top: 14px;
  padding: 12px;
  border-radius: 18px;
  background: #f8fafc;
  border: 1px solid #edf2f7;
}

.current-cabinet {
  margin-top: 14px;
  padding: 16px;
  border-radius: 18px;
  background: #f8fbff;
  border: 1px solid #dbeafe;
}

.current-box-no {
  display: block;
  font-size: 32px;
  line-height: 1;
  font-weight: 900;
  color: #2563eb;
}

.current-box-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: #64748b;
}

.cabinet-row {
  display: flex;
  gap: 8px;
  margin-bottom: 8px;
}

.cabinet-row:last-child {
  margin-bottom: 0;
}

.cabinet-cell {
  width: 18%;
  min-height: 70px;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cabinet-cell.highlight {
  border: 2px solid #2563eb;
  background: #eff6ff;
}

.cabinet-cell.occupied {
  background: #eef2ff;
}

.cabinet-cell.reserved {
  background: #fff7ed;
}

.box-no {
  font-size: 14px;
  font-weight: 900;
  color: #111827;
}

.box-status {
  margin-top: 4px;
  font-size: 10px;
  color: #64748b;
}

.btn {
  margin-top: 12px;
  height: 50px;
  line-height: 50px;
  border-radius: 16px;
  font-size: 15px;
  font-weight: 900;
}

.primary {
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
}

.success {
  color: #ffffff;
  background: #0f766e;
}

.ghost {
  color: #334155;
  background: #ffffff;
  border: 1px solid #dbe7f5;
}

.weak-error-btn {
  width: 100%;
  margin: 4px 0 0;
  height: 42px;
  line-height: 42px;
  border: 0;
  background: transparent;
  color: #ea580c;
  font-size: 13px;
  font-weight: 800;
}

.hint {
  text-align: center;
}

.courier-page {
  padding-top: 14px;
}

.courier-page .hero {
  margin-bottom: 10px;
  padding: 14px 16px;
  border-radius: 18px;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.05);
}

.courier-page .title {
  font-size: 20px;
}

.courier-page .sub {
  margin-top: 4px;
  font-size: 12px;
}

.courier-priority-card,
.compact-steps,
.courier-mini-card {
  margin-bottom: 10px;
  padding: 14px;
  border: 1px solid #e4ebf5;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

.priority-head,
.mini-head,
.action-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.action-row {
  flex-wrap: wrap;
}

.priority-title {
  display: block;
  font-size: 20px;
  line-height: 1.25;
  font-weight: 900;
  color: #111827;
}

.priority-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.priority-item {
  min-height: 58px;
  padding: 10px 12px;
  border: 1px solid #edf2f7;
  border-radius: 14px;
  background: #f8fafc;
  box-sizing: border-box;
}

.priority-item.wide {
  grid-column: span 2;
}

.strong-value {
  font-size: 18px;
  color: #0f172a;
}

.reason-card {
  margin-top: 10px;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid #fed7aa;
  background: #fff7ed;
}

.reason-title {
  display: block;
  font-size: 12px;
  font-weight: 900;
  color: #c2410c;
}

.reason-text {
  display: block;
  margin-top: 5px;
  font-size: 13px;
  line-height: 1.6;
  color: #7c2d12;
}

.compact-next {
  margin-top: 10px;
  padding: 12px;
}

.courier-priority-card .action-row {
  margin-top: 2px;
}

.half-btn {
  flex: 1;
  min-width: 0;
}

.inline-notice {
  margin-top: 10px;
  padding: 12px;
}

.slim-btn {
  height: 42px;
  line-height: 42px;
  border-radius: 14px;
  font-size: 13px;
}

.compact-steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 4px;
  padding: 12px 10px;
}

.compact-step {
  flex: 1;
  min-width: 0;
  text-align: center;
  position: relative;
}

.compact-step::after {
  content: "";
  position: absolute;
  top: 13px;
  left: 50%;
  right: -50%;
  height: 2px;
  background: #e2e8f0;
  z-index: 0;
}

.compact-step:last-child::after {
  display: none;
}

.compact-dot {
  position: relative;
  z-index: 1;
  display: inline-block;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  font-size: 12px;
  line-height: 26px;
  font-weight: 900;
}

.compact-label {
  display: block;
  margin-top: 6px;
  font-size: 11px;
  line-height: 1.2;
  color: #64748b;
  font-weight: 800;
}

.compact-step.step-current .compact-dot {
  color: #ffffff;
  background: #2563eb;
}

.compact-step.step-done .compact-dot {
  color: #ffffff;
  background: #10b981;
}

.compact-step.step-alert .compact-dot {
  color: #ffffff;
  background: #f97316;
}

.compact-step.step-current .compact-label,
.compact-step.step-alert .compact-label {
  color: #111827;
}

.toggle-btn {
  flex-shrink: 0;
  min-width: 64px;
  height: 34px;
  padding: 0 12px;
  border-radius: 999px;
  border: 1px solid #dbe7f5;
  background: #f8fafc;
  color: #2563eb;
  font-size: 12px;
  line-height: 34px;
  font-weight: 900;
}

.thumb-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 12px;
}

.proof-thumb {
  width: 88px;
  height: 64px;
  border-radius: 12px;
  background: #f8fafc;
  flex-shrink: 0;
}

.thumb-text {
  flex: 1;
  min-width: 0;
}

.thumb-title {
  display: block;
  font-size: 13px;
  font-weight: 900;
  color: #111827;
}

.thumb-desc {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  line-height: 1.5;
  color: #64748b;
}

.compact-proof {
  height: 150px;
  margin-top: 12px;
}
