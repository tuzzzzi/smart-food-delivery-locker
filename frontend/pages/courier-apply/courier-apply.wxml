<view class="page">
  <view class="hero">
    <text class="eyebrow">配送员认证</text>
    <text class="title">申请成为配送员</text>
    <text class="sub">完成手机号验证后即可提交申请，管理员审核通过后可使用投递、入柜和任务处理功能。</text>
  </view>

  <view class="status-card">
    <view class="status-card__header">
      <text class="status-card__title">当前状态</text>
      <button class="status-card__refresh" bindtap="refreshStatus">刷新</button>
    </view>
    <text class="status-pill status-{{applyStatus}}">{{applyStatusText}}</text>
    <text class="status-desc">{{statusDesc}}</text>

    <view wx:if="{{applyStatus=='rejected' && reviewNote}}" class="reject-box">
      <text class="reject-title">未通过原因</text>
      <text class="reject-text">{{reviewNote}}</text>
    </view>

    <button wx:if="{{applyStatus=='approved'}}" class="btn primary" bindtap="goRoleSelect">
      进入角色选择
    </button>
  </view>

  <view class="form-card">
    <text class="section-title form-title">身份验证</text>
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        placeholder="请输入手机号"
        value="{{phone}}"
        maxlength="20"
        bindinput="onPhone"
      />
      <text class="field-tip">验证码将发送至该手机号。</text>
    </view>

    <view class="field code-row">
      <view class="code-left">
        <text class="label">验证码</text>
        <input
          class="input"
          type="number"
          placeholder="请输入 6 位验证码"
          value="{{code}}"
          maxlength="6"
          bindinput="onCode"
        />
      </view>

      <button
        class="send-btn"
        disabled="{{sending || countdown>0 || isLocked}}"
        bindtap="sendCode"
      >
        <block wx:if="{{countdown>0}}">{{countdown}}s后重发</block>
        <block wx:else>发送验证码</block>
      </button>
    </view>

    <view wx:if="{{hintText}}" class="hint">{{hintText}}</view>

    <button
      class="btn primary"
      disabled="{{submitting || isLocked}}"
      bindtap="submitVerify"
    >
      <block wx:if="{{submitting}}">提交中...</block>
      <block wx:else>验证并提交申请</block>
    </button>
  </view>

  <view class="flow-card">
    <text class="section-title">认证流程</text>
    <view class="flow-list">
      <view class="flow-item">
        <text class="flow-no">1</text>
        <text class="flow-text">填写手机号并获取验证码</text>
      </view>
      <view class="flow-item">
        <text class="flow-no">2</text>
        <text class="flow-text">验证成功后提交申请</text>
      </view>
      <view class="flow-item">
        <text class="flow-no">3</text>
        <text class="flow-text">管理员审核通过后启用配送员身份</text>
      </view>
    </view>
  </view>

  <view class="feature-card">
    <text class="section-title">通过后你可以</text>
    <view class="feature-grid">
      <text class="feature-item">查看投递任务</text>
      <text class="feature-item">执行开柜入柜</text>
      <text class="feature-item">处理配送异常</text>
      <text class="feature-item">使用配送员工作台</text>
    </view>
  </view>
</view>
